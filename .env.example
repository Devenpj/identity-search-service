OSINT_API_BASE_URL=https://your-osint-server.example.com
OSINT_API_KEY=replace-with-provider-api-key
OSINT_SCAN_PATH=/api/v1/scan
OSINT_CALLBACK_URL=https://your-public-backend.example.com/api/webhooks/osint-results
OSINT_WEBHOOK_TOKEN=replace-with-random-webhook-token
OSINT_REQUEST_TIMEOUT_SECONDS=20
OSINT_JOB_STALE_MINUTES=15

ARTICLE_API_BASE_URL=https://article-engine.example.com
ARTICLE_API_KEY=your-secret-key
ARTICLE_SCAN_PATH=/api/v1/search
ARTICLE_CALLBACK_URL=https://your-backend-url/api/webhooks/article-results
ARTICLE_WEBHOOK_TOKEN=your-webhook-secret

# Face matching tuning. Higher threshold and gap reduce wrong auto-matches.
FACE_MATCH_THRESHOLD=0.72
FACE_MIN_SCORE_GAP=0.08
FACE_STRONG_MATCH_THRESHOLD=0.74
FACE_ENGINE_URL=http://127.0.0.1:8010
FACE_ENGINE_TIMEOUT_SECONDS=300
FACE_ENGINE_BATCH_SIZE=100
